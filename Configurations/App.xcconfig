#include "Shared.xcconfig"

// App target settings that should not vary by build configuration.
PRODUCT_BUNDLE_IDENTIFIER = com.galewilliams.nyextstep-catgirldownloader
MARKETING_VERSION = 0.0.1
CURRENT_PROJECT_VERSION = 1
GENERATE_INFOPLIST_FILE = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
CODE_SIGN_ENTITLEMENTS = Sources/Support/NyextStepCatgirlDownloader.entitlements

MACOSX_DEPLOYMENT_TARGET = 26.0
ENABLE_APP_SANDBOX[sdk=macosx*] = YES
ENABLE_HARDENED_RUNTIME[sdk=macosx*] = YES
